# Copy to backend/.env and adjust. All values are optional; sensible defaults apply.
# NEVER commit a real .env with secrets.

# Secret used for session tokens — generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
KARYANA_SECRET_KEY=change-me-in-production

# Where the SQLite DB, backups and uploads live (default: ./data)
KARYANA_DATA_DIR=data

# Optional: point at another database (e.g. PostgreSQL when scaling up)
# KARYANA_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/karyana

# This machine's POS device identity (shown in audit trail)
KARYANA_DEVICE_ID=POS-01

# --- Cloud sync / backup (integration boundary — leave blank until configured) ---
# Base URL of your remote Karyana Manager cloud server + an API key it issues you.
# KARYANA_CLOUD_URL=https://cloud.example.com
# KARYANA_CLOUD_API_KEY=

# --- WhatsApp (official Business Platform only — no unofficial libraries) ---
# KARYANA_WHATSAPP_API_URL=https://graph.facebook.com/v20.0
# KARYANA_WHATSAPP_API_TOKEN=
# KARYANA_WHATSAPP_PHONE_NUMBER_ID=
